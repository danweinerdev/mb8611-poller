# Runtime image for mb8611-poller.
#
#   podman build -f deploy/Containerfile -t localhost/mb8611-poller:dev .
#   make image            # tags $(IMAGE), see the Makefile
#
# The build context is the repository root, but only go.mod, go.sum, cmd/,
# and internal/ are copied: local files such as config.yaml or
# DO_NOT_COMMIT.txt never enter any image layer (see
# deploy/Containerfile.containerignore and .dockerignore).
#
# The result is a static, CGO-free binary on distroless static (non-root,
# UID 65532). Mount the configuration at /etc/mb8611-poller/config.yaml and
# pass secrets as MB8611_* environment variables.

ARG GO_IMAGE=docker.io/library/golang:1.26.11

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
# Set automatically by podman/buildx for the target platform.
ARG TARGETARCH=amd64
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
RUN GOOS=linux GOARCH="${TARGETARCH:-amd64}" \
    go build -trimpath -ldflags "-s -w" -o /out/mb8611-poller ./cmd/mb8611-poller

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mb8611-poller /mb8611-poller
# Numeric, so Kubernetes runAsNonRoot can verify it (distroless "nonroot").
USER 65532:65532
ENTRYPOINT ["/mb8611-poller"]
CMD ["run", "--config", "/etc/mb8611-poller/config.yaml"]
