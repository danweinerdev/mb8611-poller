          "query": "SELECT mean(\"power_dbmv\") AS \"power_dbmv\" FROM \"docsis_downstream\" WHERE $timeFilter AND \"host\" =~ /^${host:regex}$/ AND \"modem\" =~ /^${modem:regex}$/ AND \"channel\" =~ /^${channel:regex}$/ GROUP BY time($__interval), \"host\", \"modem\", \"channel\" fill(null)",
