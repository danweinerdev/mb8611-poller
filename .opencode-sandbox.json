{
  "schema_version": 1,
  "image": "localhost/mb8611-poller-opencode:latest",
  "build": {
    "containerfile": "Containerfile",
    "context": ".",
    "args": {
      "BASE_IMAGE": "opencode2:latest"
    }
  },
  "workspace": ".",
  "containers": false,
  "mounts": [
    {
      "source": ".cache/go",
      "target": "/cache/go"
    }
  ],
  "env": {
    "pass": ["GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL"],
    "set": { "TZ": "UTC" }
  },
  "command": ["opencode2", "--standalone", "--auto"]
}
