{
  "index_patterns": ["mb8611-events*"],
  "priority": 200,
  "_meta": {
    "description": "mb8611-poller docsis_event documents. Unmapped fields are kept in _source but not indexed (dynamic: false), so a new field never rejects writes."
  },
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {"type": "date"},
        "measurement": {"type": "keyword"},
        "host": {"type": "keyword"},
        "modem": {"type": "keyword"},
        "severity": {"type": "keyword"},
        "doc_id": {"type": "keyword"},
        "raw_date": {"type": "keyword"},
        "raw_time": {"type": "keyword"},
        "message": {
          "type": "text",
          "fields": {"keyword": {"type": "keyword", "ignore_above": 1024}}
        }
      }
    }
  }
}
